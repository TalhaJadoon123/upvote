# ---------------------------------------------------------------- #
# Upvote — environment template
# Copy to .env and fill in. The CLI works with none of these.
# Marked REQUIRED or the app refuses to boot in production.
# ---------------------------------------------------------------- #

# --- Database (REQUIRED for the dashboard) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/upvote
# Managed providers (Neon, Supabase) need this on:
DATABASE_SSL=false
# Accepted alias for DATABASE_URL, whichever is set first:
# POSTGRES_URL=
# Connection pool size. Default 10. Raise only if Postgres has headroom.
# DATABASE_POOL=10

# --- Auth (required for the dashboard) ---
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# --- Token encryption ---
# 32 bytes. Generate with: openssl rand -hex 32
# Rotating this invalidates every stored OAuth token.
TOKEN_ENCRYPTION_KEY=

# --- GitHub ---
# Fine-grained PAT with `repo` scope, used for reading releases/PRs/commits.
GITHUB_TOKEN=
# Accepted alias, used if GITHUB_TOKEN is unset.
# GH_TOKEN=
# Shared secret for webhook signature verification.
GITHUB_WEBHOOK_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Reddit ---
# Create a "script" app at https://www.reddit.com/prefs/apps
# The redirect URI must match exactly.
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_REDIRECT_URI=http://localhost:8787/callback

# --- Model provider (optional) ---
# With none of these set, Upvote uses the built-in offline composer, which
# is deterministic and needs no network. Set one for higher-quality drafts.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434/v1
UPVOTE_MODEL=

# Force the deterministic offline composer even when a key is present.
# Set this in CI and in any environment where drafts must be reproducible.
# UPVOTE_OFFLINE=1

# --- Billing ---
# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Lemon Squeezy (merchant of record - handles VAT/sales tax)
LEMON_SQUEEZY_WEBHOOK_SECRET=
# Paddle (merchant of record - alternative to Lemon Squeezy)
PADDLE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Commit SHA reported by /api/health. Set it in the deploy pipeline.
# GIT_COMMIT_SHA=

# --- Cross-posting (optional, amplifies a Reddit post) ---
# dev.to: https://dev.to/settings/extensions -> API key
DEVTO_API_KEY=
# Hashnode: https://hashnode.com/settings/developer -> Personal access token
HASHNODE_ACCESS_TOKEN=
HASHNODE_PUBLICATION_ID=personal

# --- Scheduler ---
# Protects /api/cron/* endpoints. Any long random string.
CRON_SECRET=
# Points the dashboard at the worker that holds the founder's Reddit token.
UPVOTE_REDDIT_PUBLISH_URL=
UPVOTE_WORKER_TOKEN=
UPVOTE_METRICS_URL=
REDIS_URL=redis://localhost:6379

# --- Runtime tuning ---
# Hostname that /api/track is allowed to redirect to besides its own origin.
# Only set this if your tracked links point at a separate marketing domain.
# Leaving it empty means same-origin redirects only, which is the safe default.
# PRODUCT_ALLOWED_HOST=

# --- Local development only (not read in production) ---
# Where the CLI keeps ~/.upvote equivalent state.
# UPVOTE_HOME=
# Print stack traces on CLI errors.
# UPVOTE_DEBUG=1
# Disable ANSI colour in CLI output.
# NO_COLOR=1
# FORCE_HYPERLINK=0

# --- Email digests (optional) ---
RESEND_API_KEY=
DIGEST_FROM_EMAIL=digest@yourdomain.com