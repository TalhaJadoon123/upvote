{
  "extends": "../../tsconfig.package.json",
  "compilerOptions": {
    "jsx": "preserve",
    "lib": ["dom", "dom.iterable", "ES2023"],
    "incremental": true,
    "types": ["mdx", "node"],
    "paths": {
      "@/*": ["./app/*"]
    }
  },
  "include": ["next-env.d.ts", "app/**/*.ts", "app/**/*.tsx", "source.config.ts"],
  "exclude": ["node_modules", "source.generated.ts"]
}