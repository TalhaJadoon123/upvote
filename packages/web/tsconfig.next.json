{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./src/*"],
      "@upvote/core": ["../core/src/index.ts"],
      "@upvote/voice": ["../voice/src/index.ts"],
      "@upvote/gh": ["../gh/src/index.ts"],
      "@upvote/reddit": ["../reddit/src/index.ts"],
      "@upvote/scheduler": ["../scheduler/src/index.ts"],
      "@upvote/analytics": ["../analytics/src/index.ts"]
    }
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}