{
  "name": "@upvote/cli",
  "version": "0.1.0",
  "private": true,
  "description": "Upvote command line interface.",
  "type": "module",
  "bin": {
    "upvote": "./src/bin.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsx src/bin.ts"
  },
  "dependencies": {
    "@upvote/analytics": "workspace:*",
    "@upvote/core": "workspace:*",
    "@upvote/gh": "workspace:*",
    "@upvote/reddit": "workspace:*",
    "@upvote/scheduler": "workspace:*",
    "@upvote/voice": "workspace:*",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "tsx": "^4.19.2"
  }
}