{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "moduleDetection": "force",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "exactOptionalPropertyTypes": false,
    "strictNullChecks": true,
    "useUnknownInCatchVariables": true,
    "baseUrl": ".",
    "paths": {
      "@upvote/core": ["./packages/core/src/index.ts"],
      "@upvote/core/*": ["./packages/core/src/*"],
      "@upvote/voice": ["./packages/voice/src/index.ts"],
      "@upvote/voice/*": ["./packages/voice/src/*"],
      "@upvote/gh": ["./packages/gh/src/index.ts"],
      "@upvote/gh/*": ["./packages/gh/src/*"],
      "@upvote/reddit": ["./packages/reddit/src/index.ts"],
      "@upvote/reddit/*": ["./packages/reddit/src/*"],
      "@upvote/scheduler": ["./packages/scheduler/src/index.ts"],
      "@upvote/scheduler/*": ["./packages/scheduler/src/*"],
      "@upvote/analytics": ["./packages/analytics/src/index.ts"],
      "@upvote/analytics/*": ["./packages/analytics/src/*"],
      "@upvote/cli": ["./packages/cli/src/index.ts"]
    }
  },
  "exclude": ["node_modules", "dist", ".next", ".turbo"]
}